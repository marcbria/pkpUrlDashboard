        { "pathTemplate": "/issue/current", "desc": "Current issue (clean/hide)", "tested": true, "modes": ["cleanUrls", "hideContext"] },
        { "pathTemplate": "/issue/archive", "desc": "Archive (clean/hide)", "tested": true, "modes": ["cleanUrls", "hideContext"] },
        { "pathTemplate": "/$$$call$$$/page/page/css?name=stylesheet", "desc": "$$$call$$$ (clean/hide)", "tested": false, "modes": ["cleanUrls", "hideContext"] }
